# =============================================================================
# Multi-Agent Employee Training System — Environment Configuration
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in ALL required values below (marked REQUIRED).
#   3. NEVER commit .env to version control.
# =============================================================================

# --- Django ---
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MongoDB ---
MONGO_ROOT_USERNAME=admin
# REQUIRED: Strong password for MongoDB root user
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=employee_training

# Full URI (auto-constructed in docker-compose, set manually for non-Docker)
# MONGODB_URI=mongodb://admin:<password>@127.0.0.1:27017/employee_training?authSource=admin

# --- Redis ---
# REQUIRED: Strong password for Redis
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0

# --- JWT ---
# REQUIRED for production. For dev, an ephemeral key is generated with a warning.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- OpenRouter (LLM Gateway) ---
# REQUIRED: Your OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model for dev/staging (free tier)
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Fallback model
OPENROUTER_FALLBACK_MODEL=mistralai/mistral-7b-instruct:free

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
